<mxfile host="app.diagrams.net"><diagram id="mapa" name="Mapa del sitio"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Mapa del sitio de Fedesarrollo" style="text;html=1;align=left;fontColor=#031C4A;fontSize=28;fontStyle=1;fontFamily=Georgia;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="44" as="geometry"/></mxCell><mxCell id="c2" value="Cada recuadro es una página. Las cajas de adentro son sus secciones, de arriba hacia abajo. Las flechas indican a qué página se llega desde otra. Para proponer un cambio, mueva, borre o agregue cajas." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#444E6E;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1300" height="40" as="geometry"/></mxCell><mxCell id="p3" value="En todas las páginas" style="swimlane;html=1;startSize=34;rounded=0;fillColor=#F6F6F6;strokeColor=#A1A7B7;fontColor=#031C4A;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="320" height="570" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Barra superior&lt;/b&gt;&lt;br&gt;Frase «Contribuimos al desarrollo del país.», enlaces a Repositorio, Contacto y Boletín, y buscador de publicaciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p3"><mxGeometry x="10" y="44" width="300" height="82" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Menú principal&lt;/b&gt;&lt;br&gt;Investigaciones, Coyuntura, Áreas, Equipo, Noticias y eventos, Nosotros" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p3"><mxGeometry x="10" y="134" width="300" height="66" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Menú desplegable de Investigaciones&lt;/b&gt;&lt;br&gt;Por tipo (investigaciones, libros, comisiones, Documentos y Notas de Política), por tema (14 temas) y Especiales (Documentos de Política 2026-2030, Organizados contra el crimen y Explorador de marcos regulatorios)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p3"><mxGeometry x="10" y="208" width="300" height="114" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Menú desplegable de Coyuntura&lt;/b&gt;&lt;br&gt;Encuestas (EOC, EOE, EOF, IPEC y Renta variable), publicaciones periódicas y calendario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p3"><mxGeometry x="10" y="330" width="300" height="66" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Menú desplegable de Áreas&lt;/b&gt;&lt;br&gt;Macrofiscal, Seguridad y justicia, Instituciones y capital humano, Mercado laboral y productividad y Investigaciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p3"><mxGeometry x="10" y="404" width="300" height="82" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Pie de página&lt;/b&gt;&lt;br&gt;Suscripción al boletín, enlaces del sitio, dirección, teléfono, correo y redes sociales" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p3"><mxGeometry x="10" y="494" width="300" height="66" as="geometry"/></mxCell><mxCell id="p10" value="Inicio" style="swimlane;html=1;startSize=34;rounded=0;fillColor=#031C4A;strokeColor=#031C4A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="130" width="680" height="500" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;1. Portada que rota&lt;/b&gt;&lt;br&gt;Destacados actuales: Encuesta de Opinión Financiera, Documentos de Política 2026-2030 y Organizados contra el crimen" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="44" width="660" height="66" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;2. Lo más reciente&lt;/b&gt;&lt;br&gt;La investigación más reciente en grande, dos más debajo y, al lado, la última edición de cada encuesta o informe de coyuntura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="118" width="660" height="66" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;3. Indicadores de coyuntura&lt;/b&gt;&lt;br&gt;ICC 15,7%, ICCO 23,3%, IPEC 237 y EOF 12,50%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="192" width="660" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;4. Documentos de Política 2026-2030&lt;/b&gt;&lt;br&gt;Portadas de los primeros cuatro documentos de la serie" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="250" width="660" height="50" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;5. Áreas de investigación&lt;/b&gt;&lt;br&gt;Macrofiscal, Seguridad y justicia, Instituciones y capital humano, Mercado laboral y productividad y Investigaciones" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="308" width="660" height="66" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;6. Dirección&lt;/b&gt;&lt;br&gt;Foto de la directora ejecutiva y de los directores de área" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="382" width="660" height="50" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;7. En los medios y Eventos&lt;/b&gt;&lt;br&gt;Cinco notas de prensa y cuatro eventos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p10"><mxGeometry x="10" y="440" width="660" height="50" as="geometry"/></mxCell><mxCell id="p18" value="Investigaciones" style="swimlane;html=1;startSize=34;rounded=0;fillColor=#031C4A;strokeColor=#031C4A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="320" height="416" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Introducción&lt;/b&gt;&lt;br&gt;Qué se encuentra en la página y enlace a Coyuntura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p18"><mxGeometry x="10" y="44" width="300" height="66" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Especiales&lt;/b&gt;&lt;br&gt;Documentos de Política 2026-2030, Organizados contra el crimen y Explorador de marcos regulatorios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p18"><mxGeometry x="10" y="118" width="300" height="82" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Buscador y filtros&lt;/b&gt;&lt;br&gt;Buscar por título, autor o palabra y filtrar por tipo, área y tema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p18"><mxGeometry x="10" y="208" width="300" height="66" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Lista de publicaciones&lt;/b&gt;&lt;br&gt;Portada, tipo, título, autores, resumen corto y fecha. 15 por página" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p18"><mxGeometry x="10" y="282" width="300" height="66" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Cada publicación abre su ficha en el repositorio institucional&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#081BFD;dashed=1;fontColor=#081BFD;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p18"><mxGeometry x="10" y="356" width="300" height="50" as="geometry"/></mxCell><mxCell id="p24" value="Coyuntura" style="swimlane;html=1;startSize=34;rounded=0;fillColor=#031C4A;strokeColor=#031C4A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="400" y="780" width="320" height="664" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Introducción&lt;/b&gt;&lt;br&gt;Encuestas e indicadores que Fedesarrollo publica cada mes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="44" width="300" height="66" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Indicadores&lt;/b&gt;&lt;br&gt;ICC 15,7%, ICCO 23,3%, IPEC 237 y EOF 12,50%" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="118" width="300" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Próximas publicaciones&lt;/b&gt;&lt;br&gt;Las siguientes ocho fechas del calendario de encuestas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="176" width="300" height="66" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Encuesta de Opinión del Consumidor&lt;/b&gt;&lt;br&gt;Descripción y los dos últimos resultados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="250" width="300" height="50" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Encuesta de Opinión Empresarial&lt;/b&gt;&lt;br&gt;Descripción y los dos últimos resultados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="308" width="300" height="50" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Encuesta de Opinión Financiera&lt;/b&gt;&lt;br&gt;Descripción y los dos últimos resultados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="366" width="300" height="50" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Índice de Incertidumbre de la Política Económica&lt;/b&gt;&lt;br&gt;Descripción y los dos últimos resultados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="424" width="300" height="66" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Indicadores de confianza del mercado de renta variable&lt;/b&gt;&lt;br&gt;Descripción y los dos últimos resultados" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="498" width="300" height="66" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Todas las publicaciones de coyuntura&lt;/b&gt;&lt;br&gt;Encuestas, Prospectiva Económica, Tendencia Económica, Bitácora Semanal y comunicados, con filtro por serie" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p24"><mxGeometry x="10" y="572" width="300" height="82" as="geometry"/></mxCell><mxCell id="p34" value="Áreas" style="swimlane;html=1;startSize=34;rounded=0;fillColor=#031C4A;strokeColor=#031C4A;fontColor=#FFFFFF;fontSize=14;fontStyle=1;swimlaneFillColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="780" width="320" height="580" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;Introducción&lt;/b&gt;&lt;br&gt;Fedesarrollo organiza su trabajo en cinco áreas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F6F6;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p34"><mxGeometry x="10" y="44" width="300" height="66" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Macrofiscal&lt;/b&gt;&lt;br&gt;Política fiscal y monetaria, finanzas públicas, sector financiero y comercio exterior." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p34"><mxGeometry x="10" y="118" width="300" height="66" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Seguridad y justicia&lt;/b&gt;&lt;br&gt;Crimen organizado, sistema de justicia, cárceles, corrupción y política de seguridad en Colombia y América Latina." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p34"><mxGeometry x="10" y="192" width="300" height="82" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Instituciones y capital humano&lt;/b&gt;&lt;br&gt;Educación, salud y desarrollo regional." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p34"><mxGeometry x="10" y="282" width="300" height="50" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Mercado laboral y productividad&lt;/b&gt;&lt;br&gt;Empleo, pobreza, protección social, desarrollo productivo y sector agropecuario." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#BBD4F3;strokeColor=none;fontColor=#031C4A;fontSize=11;align=left;verticalAlign=top;spacing=8;fontFamily=Helvetica;" vertex="1" parent="p34"><mxGeometry x="10" y="340" width="300" height="66" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Investigaciones&lt;/b&gt;&lt;br&gt;Energía, infr